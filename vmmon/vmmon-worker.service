[Unit]
Description=VM Monitor worker (kontroller, hosts och larm)
After=network-online.target mysql.service mariadb.service

[Service]
# Kör som samma användare som webbservern (behöver läsa config.local.php och secret.php)
User=www-data
WorkingDirectory=/var/www/vmmon
ExecStart=/usr/bin/php /var/www/vmmon/worker.php
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
